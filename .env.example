# Copy to .env (git-ignored) for ./scripts/jev-smoke.sh. Shell variables override these.
# Jev through OpenRouter (https://openrouter.ai/docs/guides/community/typesafe-sdk):
OPENROUTER_API_KEY=
# Or TypeSafe's own API (used when OPENROUTER_API_KEY is empty, or with JEV_ENDPOINT=typesafe):
# TYPESAFE_API_KEY=
# JEV_ENDPOINT=openrouter
# JEV_MODEL=jev-latest
# JEV_TIMEOUT_SECONDS=120
