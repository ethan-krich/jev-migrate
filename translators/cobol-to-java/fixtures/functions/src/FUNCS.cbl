       IDENTIFICATION DIVISION.
       PROGRAM-ID. FUNCS.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 S    PIC X(10) VALUE "  Hello  ".
       01 N    PIC S9(5)V99 VALUE -12.75.
       01 M    PIC 9(3) VALUE 17.
       01 R    PIC S9(7)V9(4).
       01 D8   PIC 9(8) VALUE 20240229.
       01 IDAY PIC 9(7).
       01 TXT  PIC X(12).
       01 VALS.
          05 V PIC 9(3) OCCURS 3.
       PROCEDURE DIVISION.
           DISPLAY "[" FUNCTION UPPER-CASE(S) "]".
           DISPLAY "[" FUNCTION LOWER-CASE(S) "]".
           DISPLAY "[" FUNCTION REVERSE(S) "]".
           DISPLAY "[" FUNCTION TRIM(S) "]".
           DISPLAY FUNCTION LENGTH(S) " " FUNCTION LENGTH("abc").
           DISPLAY FUNCTION LENGTH(FUNCTION TRIM(S)).
           DISPLAY FUNCTION MOD(M 5) " " FUNCTION MOD(-17 5).
           DISPLAY FUNCTION MOD(17 -5).
           DISPLAY FUNCTION REM(M 5) " " FUNCTION REM(-17 5).
           DISPLAY FUNCTION INTEGER(N) " " FUNCTION INTEGER-PART(N).
           DISPLAY FUNCTION INTEGER(-0.5) " " FUNCTION INTEGER(2.5).
           DISPLAY FUNCTION ORD-MAX(3 M 9) " " FUNCTION ORD-MIN(3 M 9).
           DISPLAY FUNCTION ORD("A") " " FUNCTION CHAR(66).
           DISPLAY FUNCTION INTEGER-OF-DATE(D8).
           MOVE FUNCTION INTEGER-OF-DATE(D8) TO IDAY.
           DISPLAY FUNCTION DATE-OF-INTEGER(IDAY).
           DISPLAY FUNCTION DAY-OF-INTEGER(150000).
           DISPLAY FUNCTION INTEGER-OF-DAY(2024060).
           DISPLAY FUNCTION INTEGER-OF-DATE(20241399).
           COMPUTE R = FUNCTION MOD(M 5) + FUNCTION ABS(N).
           DISPLAY R.
           MOVE FUNCTION MAX(3 M 9) TO R.
           DISPLAY R.
           MOVE FUNCTION MIN(N 1.5) TO R.
           DISPLAY R.
           MOVE FUNCTION SUM(N M 1.5) TO R.
           DISPLAY R.
           MOVE FUNCTION NUMVAL(" -12.50 ") TO R.
           DISPLAY R.
           MOVE FUNCTION NUMVAL-C("$1,234.50CR") TO R.
           DISPLAY R.
           MOVE FUNCTION NUMVAL("abc") TO R.
           DISPLAY R.
           MOVE FUNCTION UPPER-CASE(S) TO S.
           DISPLAY "[" S "]".
           MOVE FUNCTION CURRENT-DATE(1:14) TO TXT.
           DISPLAY "[" TXT "]".
           MOVE 5 TO V(1). MOVE 50 TO V(2). MOVE 7 TO V(3).
           MOVE FUNCTION MAX(V(1) V(2) V(3)) TO R.
           DISPLAY R.
           IF FUNCTION UPPER-CASE("abc") = "ABC" DISPLAY "upper ok".
           IF FUNCTION MOD(M 2) = 1 DISPLAY "odd".
           STOP RUN.
