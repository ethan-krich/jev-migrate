{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transpiler.local/protocol/mapping.schema.json",
  "title": "Mapping registry",
  "description": "Serialized mapping registry passed from Python through the orchestrator to a translator worker (initialize.params.mappings). Workers additionally validate handler ids, operations and condition keys against their own catalog.",
  "type": "object",
  "required": ["version", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "rules": {"type": "array", "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "scalar": {"type": ["string", "number", "boolean", "null"]},
    "rule": {
      "type": "object",
      "required": ["id", "source", "strategy"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1, "description": "Stable identifier; unique within the registry"},
        "source": {"type": "string", "minLength": 1, "description": "Source operation, e.g. a COBOL verb (MOVE, ADD, GOBACK, GO_TO)"},
        "strategy": {"enum": ["builtin", "unresolved", "callback"]},
        "handler": {"type": "string", "minLength": 1, "description": "Builtin handler id (builtin strategy only)"},
        "when": {
          "type": "object",
          "description": "Conditions over per-instance facts; a list matches any of its values",
          "additionalProperties": {
            "oneOf": [{"$ref": "#/$defs/scalar"}, {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/scalar"}}]
          }
        },
        "priority": {"type": "integer"},
        "callback": {
          "type": "object",
          "required": ["script", "function"],
          "additionalProperties": false,
          "properties": {"script": {"type": "string"}, "function": {"type": "string"}}
        },
        "description": {"type": "string"}
      },
      "allOf": [
        {"if": {"properties": {"strategy": {"const": "builtin"}}}, "then": {"required": ["handler"], "not": {"required": ["callback"]}}},
        {"if": {"properties": {"strategy": {"const": "callback"}}}, "then": {"required": ["callback"], "not": {"required": ["handler"]}}},
        {"if": {"properties": {"strategy": {"const": "unresolved"}}}, "then": {"not": {"anyOf": [{"required": ["handler"]}, {"required": ["callback"]}]}}}
      ]
    }
  }
}
